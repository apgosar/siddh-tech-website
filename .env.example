# Used by apps/corporate's next.config.mjs to proxy /neev and /swasthyaconnect
# onto their own deployments. In local dev the defaults (each app's own dev
# port) just work — copy this file to .env.local only when pointing the
# corporate site at deployed product apps instead of local dev servers.
# NEEV_ORIGIN=https://neev-<project>.vercel.app
# SWASTHYACONNECT_ORIGIN=https://swasthyaconnect-<project>.vercel.app

# Contact-form notification email (apps/corporate/lib/mail.ts).
# GMAIL_USER is the Gmail address the notification is sent FROM — it needs
# an app password, not the account's real password: generate one at
# https://myaccount.google.com/apppasswords (only available once 2-Step
# Verification is turned on for that account).
# CONTACT_NOTIFY_TO is who receives it; defaults to GMAIL_USER if unset —
# once ankur@siddhtech.ai exists as a real inbox (e.g. via Cloudflare Email
# Routing), point this there instead.
#
# Copy this file to .env.local (gitignored) and fill in real values — never
# commit an actual app password.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your16characterapppassword
# CONTACT_NOTIFY_TO=ankur@siddhtech.ai
